# Environment Configuration: AI Bug Prediction System

# Database Configuration (Local PostgreSQL)
# Format: postgresql://<USER>:<PASSWORD>@localhost:<PORT>/<DATABASE_NAME>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_bug_prediction"

# NextAuth / JWT Authentication
NEXTAUTH_SECRET="ai-bug-prediction-dev-secret-key-change-in-production-32chars"
NEXTAUTH_URL="http://localhost:3000"

# Optional: GitHub Personal Access Token (for higher rate limit: 5000 req/hr)
GITHUB_TOKEN=""

# NVIDIA NIM Semantic AI Engine Configuration
NVIDIA_API_KEY=""
NVIDIA_MODEL="meta/llama-3.3-70b-instruct"

# Node Environment
NODE_ENV="development"
